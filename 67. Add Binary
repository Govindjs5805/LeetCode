Given two binary strings a and b, return their sum as a binary string.




class Solution:
    def addBinary(self, a: str, b: str) -> str:
        temp=0
        result=[]
        lista=list(a)
        listb=list(b)
        while lista and listb:
            x=lista.pop()
            y=listb.pop()
            if x=='0' and y=='0':
                if temp==0:
                    result.append('0')
                else:
                    result.append('1')
                    temp=0
            elif x=='0' and y=='1':
                if temp==0:
                    result.append('1')
                else:
                    result.append('0')
            elif x=='1' and y=='0':
                if temp==0:
                    result.append('1')
                else:
                    result.append('0')
            else:
                if temp==0:
                    result.append('0')
                    temp=1
                else:
                    result.append('1')
        while lista:
            m=lista.pop()
            if m=='0':
                if temp==0:
                    result.append('0')
                else:
                    result.append('1')
                    temp=0
            else:
                if temp==0:
                    result.append('1')
                else:
                    result.append('0')
        while listb:
            m=listb.pop()
            if m=='0':
                if temp==0:
                    result.append('0')
                else:
                    result.append('1')
                    temp=0
            else:
                if temp==0:
                    result.append('1')
                else:
                    result.append('0')
        if temp==1:
            result.append('1')
        return "".join(reversed(result))
