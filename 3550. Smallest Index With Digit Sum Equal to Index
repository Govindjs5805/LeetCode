You are given an integer array nums.

Return the smallest index i such that the sum of the digits of nums[i] is equal to i.

If no such index exists, return -1.




class Solution:
    def smallestIndex(self, nums: List[int]) -> int:
        n=len(nums)
        for i in range(n):
            l1=[]
            while nums[i]>0:
                digit = nums[i] % 10
                l1.append(digit)
                nums[i] = nums[i]//10
            if sum(l1) == i:
                return i
        return -1
